{
  "name": "video-processing-pipeline",
  "version": "1.0.0",
  "description": "A video processing pipeline app for Cloudflare Workers",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "build": "run-s build:*",
    "build:ui": "cd ui && npm run build",
    "postbuild:ui": "shx touch public/.gitkeep",
    "prebuild:worker": "npm run generate:types",
    "build:worker": "tsc -b src --noEmit",
    "check": "run-s check:*",
    "check:biome": "biome check .",
    "check:infra": "terraform -chdir=infra validate",
    "check:markdown": "markdownlint-cli2 'docs/*.md' 'docs/issues/*.md' '#node_modules'",
    "check:types": "tsc -b --noEmit",
    "db:migrate:remote": "wrangler d1 migrations apply video-pipeline-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply video-pipeline-db --local",
    "predeploy": "run-s generate:types build db:migrate:remote",
    "deploy": "wrangler deploy",
    "fix": "run-s fix:*",
    "fix:biome": "biome check --write .",
    "fix:infra": "terraform -chdir=infra fmt",
    "generate:cors": "wrangler r2 bucket cors set video-pipeline-bucket --file infra/r2-cors.json --force --config wrangler.jsonc",
    "generate:types": "generate-types -- --strict-vars=false",
    "generate:types:test": "wrangler types --config wrangler.test.jsonc --strict-vars=false",
    "generate:wrangler": "generate-wrangler -cf -t infra",
    "preprovision": "terraform -chdir=infra init",
    "provision": "terraform -chdir=infra apply -auto-approve",
    "postprovision": "run-s generate:wrangler generate:cors",
    "prestart": "run-s generate:types build db:migrate:local",
    "start": "wrangler dev",
    "preteardown": "node scripts/empty-bucket.mjs",
    "teardown": "terraform -chdir=infra destroy -auto-approve",
    "postteardown": "shx rm -f wrangler.jsonc worker-configuration.d.ts",
    "pretest": "run-s generate:types:test",
    "test": "vitest run",
    "pretest:worker": "run-s generate:types:test",
    "test:worker": "vitest run --project worker",
    "pretest:ui": "run-s generate:types:test",
    "test:ui": "vitest run --project ui",
    "pretest:container": "run-s generate:types:test",
    "test:container": "vitest run --project container",
    "pretest:integration": "run-s generate:types:test",
    "test:integration": "vitest run --project integration",
    "pretest:coverage": "run-s generate:types:test",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@adrianhall/cloudflare-scripts": "github:adrianhall/cloudflare-scripts#v1.0.1",
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/vitest-pool-workers": "^0.16.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "^4.1.7",
    "jsdom": "^26.1.0",
    "markdownlint-cli2": "0.22.1",
    "npm-run-all2": "^9.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shx": "^0.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  },
  "dependencies": {
    "@adrianhall/cloudflare-auth": "github:adrianhall/cloudflare-auth#1.0.1",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@cloudflare/containers": "^0.3.5",
    "hono": "^4.12.23"
  }
}
